# Required
DISCORD_TOKEN=your_discord_bot_token_here
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_NAME=mistral-large-latest
BRAVE_API_KEY=your_brave_api_key_here

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/andre-discord-bot
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/andre-discord-bot

# Optional
DATA_DIR=./data
MISTRAL_MAX_MESSAGES_IN_HISTORY=10